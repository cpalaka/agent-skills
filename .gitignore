.DS_Store
docs/scratch/
__pycache__/
# skill-updater's suite runs from a venv (its SKILL.md says so), and a venv's activate script,
# pyvenv.cfg and console-script shebangs all carry an absolute home path. The stdlib venv and
# pytest each drop a `*` .gitignore inside their own directory, so most of the time these two
# rules are belt-and-braces — but a tool that omits that file leaves every one of those paths
# in front of the leak-guard (measured 2026-09-01, both self-ignores removed: 979 extra files
# reached the scan and 33 matched; these rules alone returned it to clean).
.venv/
.pytest_cache/

# Claude Code workspace plumbing — never publish.
# `.claude/*` rather than `.claude/`: git will not descend into an ignored DIRECTORY, so a
# negation beneath a `.claude/` pattern can never re-include anything. settings.json is tracked
# on purpose — it carries this repo's attribution policy, which must hold on any machine.
.claude/*
!.claude/settings.json
.superpowers/
# CLAUDE.md is intentionally TRACKED (repo operating notes) — keep it mechanics-only, no secrets/private paths.

# Per-ticket working notes (rule ledgers, execution specs, run state). Untracked AND unignored,
# these reach `leak-guard.sh scan`, and a ticket's own notes carry absolute home paths — so the
# tree gate goes permanently red and stops carrying information (measured 2026-09-19: 22 hits from
# three working files, against 2 from the planted canary). Durable output belongs on the ticket.
.scratch/
